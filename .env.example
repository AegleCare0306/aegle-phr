# Copy to .env and fill in real values. .env is gitignored; this file is not.
# PLACEHOLDERS ONLY -- never put a real credential in this file.

ABDM_CLIENT_ID=SBXID_XXXXXX
ABDM_CLIENT_SECRET=replace-me

ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api/v3
ABDM_HIECM_BASE_URL=https://dev.abdm.gov.in/api/hiecm
# Consent Auto-Approval's own distinct host (create-pin/verify-pin/
# auto-approve) -- confirmed via a live-captured Postman example, not the
# spec PDF. See aegle_phr/phr/consent.py's own module banner.
ABDM_CM_BASE_URL=https://dev.abdm.gov.in/cm
ABDM_X_CM_ID=sbx

# The public host ABDM sends callbacks to (ngrok tunnel in sandbox).
ABDM_CALLBACK_URL=https://your-tunnel-host.ngrok-free.dev

# The PHR's own HIU identifier, sent as the X-HIU-ID header.
# No longer a total unknown as of P15: every HIU-role call built in this
# project (Data Flow self-view, Subscription self-subscription, Consent
# Auto-Approval, and now User-Initiated Linking) has consistently used
# CLIENT_ID (this bridge's own registration id) for this value. Set it to
# the same value as ABDM_CLIENT_ID above. Still worth a live confirmation
# check before any NEW endpoint family's first real call, same discipline
# applied every time this value has been reused so far.
ABDM_HIU_ID=

# Full URL of the PHR public-certificate endpoint. Leave commented out to
# use the derived default, {ABDM_ABHA_BASE_URL}/phr/app/login/public/certificate.
# NOTE this is a DIFFERENT endpoint from the existing backend's
# .../profile/public/certificate -- do not point them at the same URL.
# PHR_CERTIFICATE_URL=

# Shared access key for the app API, sent by the test UI as X-Aegle-Key.
# Gates the app API only -- NOT the ABDM callback routes, which ABDM could
# never send it on. Empty/unset means the app API rejects everything (fail
# closed). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PHR_API_ACCESS_KEY=

# Matches docker-compose.yml (host port 5433, not 5432).
DATABASE_URL=postgresql+psycopg://aegle:aegle@localhost:5433/aegle_phr

# Complex types are parsed as JSON by pydantic-settings.
CORS_ORIGINS=["http://localhost:5173"]

# Where abdm_core writes flow logs and API captures. Relative paths are
# resolved against this repo's root.
STORAGE_ROOT=storage
LOG_DIR=logs
